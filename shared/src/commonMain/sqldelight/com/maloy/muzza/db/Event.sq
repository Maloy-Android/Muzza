CREATE TABLE IF NOT EXISTS event (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    songId TEXT NOT NULL,
    timestamp TEXT NOT NULL,
    playTime INTEGER NOT NULL DEFAULT 0
);

CREATE INDEX IF NOT EXISTS event_songId ON event(songId);

insert:
INSERT INTO event(songId, timestamp, playTime) VALUES (?, ?, ?);

selectBySong:
SELECT * FROM event WHERE songId = :songId ORDER BY timestamp DESC;

selectRecent:
SELECT * FROM event ORDER BY timestamp DESC LIMIT :limit;

deleteOlderThan:
DELETE FROM event WHERE timestamp < :cutoff;
